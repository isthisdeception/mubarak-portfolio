# ==============================================================================
# Prism Pulse Backend — Environment Configuration (.env.example)
# ==============================================================================

# Django Secret Key (generate a strong unique key for production)
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-in-production

# Debug Mode (set to False in production)
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated list of domains/IPs)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Option 1: Discrete environment variables
POSTGRES_DB=prism_pulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Option 2: Full connection URL (Render / PaaS / Docker)
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/prism_pulse_db

# ------------------------------------------------------------------------------
# Security & Origins
# ------------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CSRF Trusted Origins (comma-separated, required for HTTPS Django Admin)
CSRF_TRUSTED_ORIGINS=
